{
  "name": "@jam/linearlite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:electric": "VITE_SYNC_URL=http://localhost:3001 playwright test e2e/electric.spec.ts",
    "backend:up": "tsx backend/containers.ts up && pnpm db:migrate && pnpm db:load-data",
    "backend:down": "tsx backend/containers.ts down",
    "backend:logs": "tsx backend/containers.ts logs",
    "db:migrate": "tsx db/migrate.ts",
    "db:load-data": "tsx db/load-data.ts",
    "sync-server": "tsx server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-sync": "^0.6.9",
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^1.13.0",
    "@jam/core": "workspace:*",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.5",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
